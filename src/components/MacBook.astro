---
// Bildschirmfoto der PC-Oberfläche in einem schlichten MacBook-Rahmen (nur CSS, kein fremdes Bild).
import { url } from '../site';

interface Props {
  name: string; // Dateiname ohne Endung in public/img, es gibt jeweils -900.webp und .webp
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { name, alt, sizes = '(max-width: 960px) 92vw, 640px', eager = false, class: className = '' } = Astro.props;
---

<div class:list={['macbook', className]}>
  <div class="macbook-lid">
    <div class="macbook-screen">
      <img
        src={url(`img/${name}.webp`)}
        srcset={`${url(`img/${name}-900.webp`)} 900w, ${url(`img/${name}.webp`)} 1600w`}
        sizes={sizes}
        width="1600"
        height="1000"
        alt={alt}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </div>
  </div>
  <div class="macbook-base" aria-hidden="true"></div>
</div>
