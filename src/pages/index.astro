---
import Base from '../layouts/Base.astro';
import MacBook from '../components/MacBook.astro';
import Phone from '../components/Phone.astro';
import Telefon from '../components/Telefon.astro';
import { ANBIETER, EMAIL, GITHUB_URL, LINKEDIN_URL, absoluteUrl, letztesRelease, mailto, url } from '../site';

const title = 'Kostenlose Handwerkersoftware – Open Source, mit E-Rechnung';
const description =
  'Angebote, Rechnungen mit E-Rechnung, Zeiterfassung per Handy, Nachkalkulation. Kostenlos und Open Source, aus dem Metallbau. Einrichtung auf Wunsch.';

const release = await letztesRelease();
const releaseDatum = release?.datum.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Berlin' });
const releaseIso = release?.datum.toISOString().slice(0, 10);

const faqs = [
  {
    q: 'Gibt es kostenlose Handwerkersoftware ohne Abo?',
    a: 'Ja. Das Handwerkerprogramm ist eine Handwerkersoftware mit offenem Quellcode (Lizenz AGPL v3), also ein ERP-System für Handwerksbetriebe, und kostet nichts, auch nicht pro Mitarbeiter. Es deckt den Ablauf von der Anfrage bis zur bezahlten Rechnung ab: Angebote und Rechnungen mit E-Rechnung nach EN 16931 (ZUGFeRD, XRechnung), Zeiterfassung per Handy auch ohne Netz, Bautagebuch und Nachkalkulation je Projekt. Es läuft auf einem Windows-PC oder Linux-Server in Ihrem Büro, Ihre Daten bleiben also im Betrieb. Entstanden ist es im Metallbaubetrieb meiner Familie mit sechs Mitarbeitern, dort läuft es seit einem Jahr jeden Tag.',
  },
  {
    q: 'Was kostet das Programm?',
    a: 'Nichts. Das Programm ist Open Source und kostenlos, ohne Abo und ohne Gebühr pro Mitarbeiter. Geld kostet nur die Einrichtung, wenn ich sie für Sie übernehme: 50 € pro Stunde, meist 3 bis 4 Tage, also rund 1.200 bis 1.600 €. Als Kleinunternehmer nach § 19 UStG berechne ich keine Umsatzsteuer. Vorher bekommen Sie ein Angebot.',
  },
  {
    q: 'Warum ist das Programm kostenlos?',
    a: 'Weil mir die Abo-Modelle der Cloud-Anbieter viel zu teuer sind. Dort zahlt ein Betrieb jeden Monat, oft pro Mitarbeiter, und seine Daten liegen beim Anbieter. Das Handwerkerprogramm ist meine Gegenbewegung dazu: Es läuft im eigenen Büro, der Quellcode ist offen, und jeder darf es kostenlos nutzen. Geld verdiene ich nur, wenn ich die Einrichtung für Sie übernehme.',
  },
  {
    q: 'Wie lange gibt es das Programm schon?',
    a: 'Seit zwei Jahren. Angefangen habe ich es 2024 als Projekt im Wirtschaftsinformatik-Studium, seitdem arbeite ich laufend daran. Seit einem Jahr läuft es jeden Tag im Metallbaubetrieb meiner Familie, und was dort im Alltag hakt, bessere ich nach.',
  },
  {
    q: 'Wo liegen meine Daten?',
    a: 'Auf einem Rechner in Ihrem Betrieb, zum Beispiel einem Büro-PC. Ihre Daten liegen nicht bei einem Software-Anbieter. Jede Nacht sichert das Programm alles auf eine externe Festplatte und in Ihr OneDrive mit Geschäftskonto. Nur wenn Sie die freiwilligen KI-Funktionen einschalten, gehen Belege und Texte zum Auslesen an Google.',
  },
  {
    q: 'Kann ich meine Daten aus dem alten Programm mitnehmen?',
    a: 'Ja. Kunden, Lieferanten, Artikel und weitere Stammdaten übernehme ich innerhalb einer Woche aus Ihrem bisherigen Programm. Am einfachsten ist der Umstieg zum Jahresanfang, weil Arbeitszeiten und Urlaubskonten dann frisch starten. Unterm Jahr geht es auch, braucht aber etwas mehr Abstimmung.',
  },
  {
    q: 'Was ist, wenn Sie einmal keine Zeit mehr haben?',
    a: 'Das Programm läuft auf Ihrem Rechner weiter, auch ohne mich. Der Quellcode ist öffentlich, und Ihre Daten liegen in einer gewöhnlichen Datenbank in Ihrem Betrieb. Jeder IT-Dienstleister kann die Betreuung übernehmen.',
  },
  {
    q: 'Für welche Gewerke passt es?',
    a: 'Gebaut wurde es im Metallbau, es passt aber zu den meisten Gewerken: Schlosserei, Schreinerei, Elektro, Sanitär und Heizung. Die Abläufe von der Anfrage bis zur Schlussrechnung sind fast überall gleich. Was bei Ihnen anders läuft, klären wir vorher.',
  },
  {
    q: 'Unterstützt das Programm die EN 1090?',
    a: 'Zum Teil. Werkstoffzeugnisse Ihrer Lieferanten (3.1, 3.2 und 2.2 nach EN 10204) erkennt das Programm mit Werkstoff und Charge und hängt sie an den Lieferschein. Jedes Projekt hat einen eigenen Ordner für die 1090-Dokumentation. Weitere Bausteine sind in Planung, Ihre Anmerkungen dazu sind ausdrücklich erwünscht.',
  },
  {
    q: 'Auf welchem Rechner läuft es?',
    a: 'Auf einem Windows-PC oder Linux-Server, der im Büro läuft. Gearbeitet wird im Browser, also an jedem Rechner im Betrieb. Die Handy-App läuft im Browser von iPhone und Android.',
  },
  {
    q: 'Kann das Programm E-Rechnungen?',
    a: 'Ja. Rechnungen gehen als ZUGFeRD oder XRechnung nach EN 16931 raus, und E-Rechnungen von Lieferanten werden automatisch eingelesen.',
  },
  {
    q: 'Brauche ich dafür KI?',
    a: 'Nein. Die KI-Funktionen sind freiwillig und ohne Schlüssel komplett aus. E-Rechnungen von Lieferanten lesen sich dann weiter von selbst ein, normale PDF-Rechnungen tragen Sie von Hand ein.',
  },
  {
    q: 'Kann ich es auch selbst installieren?',
    a: 'Ja. Die Schritt-für-Schritt-Anleitung liegt auf GitHub. Unter Windows startet die Einrichtung per Doppelklick und installiert fehlende Teile mit. Sicherung und Handy-Zugang richten Sie danach nach Checkliste ein. Etwas PC-Erfahrung sollten Sie mitbringen.',
  },
];

const home = absoluteUrl();
const person = `${home}#marvin`;
const software = `${home}#software`;
